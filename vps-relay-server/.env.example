# Relay server authentication token (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
RELAY_TOKEN=your-secret-token-here

# Server port
PORT=3456

# Extra allowed target domains (comma-separated, supports *.suffix wildcards)
# Built-in: booking.taiwantravelmap.com, booking.travelmap.com.tw
# Example for OwlTing: api.owlting.com,*.owlting.com
EXTRA_ALLOWED_DOMAINS=
