# 複製為 secrets.env 後填值（一行 KEY=value，值不要加引號除非含空白）。來源：舊專案 Lovable 後台 Cloud → Secrets 逐一抄出。
# 不需要的整行刪除；Supabase 自動注入的 SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 不用填。

## 遷移新增（去 Lovable 化）
AUTH_HOOK_SECRET=            # 新產生：openssl rand -hex 32；同值填到 Dashboard → Auth → Hooks → Send Email
LLM_MODE=direct              # gateway=走 Lovable AI gateway（切換後不可用）；direct=直接打 Google / OpenAI
GEMINI_API_KEY=              # Google AI Studio，取代 LOVABLE_API_KEY 的 Gemini 呼叫
OPENAI_API_KEY=              # 語音轉文字 gpt-4o-mini-transcribe（程式已有此 key 名稱）
ALLOWED_PREVIEW_HOSTS=       # 取代 lovableproject.com 判斷；逗號分隔，可留空
MIGRATION_KEY=               # 只設在「舊」專案（Lovable 端）給 migration-storage-sync 用，新專案不用

## 程式碼實際使用（Deno.env.get 盤點，依使用次數排序）
RESEND_API_KEY_LAKEZE=
RESEND_API_KEY=
# LOVABLE_API_KEY=   # 不搬：Lovable 專用，改由 GEMINI_API_KEY / AUTH_HOOK_SECRET 取代
