# 複製為 migration.env 後填入。此檔內容等同 production 鑰匙，不進 git。
NEW_REF=                       # 新專案 ref，例如 abcdefghijklmnop
NEW_DB_URL=                    # postgresql://postgres.<NEW_REF>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres （用 session pooler 5432，不要 6543）
NEW_SERVICE_ROLE_KEY=          # 新專案 service role（或 sb_secret_...）
NEW_ANON_KEY=                  # 新專案 anon（legacy JWT；若無則填 sb_publishable_...）
OLD_REF=dmafqwfynatdvnaeovhz
OLD_ANON_KEY=                  # 從 .env 的 VITE_SUPABASE_PUBLISHABLE_KEY 取
DUMP_FILE=                     # Lovable 匯出檔路徑（.sql 或 .dump）
SCRATCH_DB_URL=                # 本機 Postgres（docker）用來還原匯出檔做 diff / 取 cron，例如 postgresql://postgres:postgres@localhost:54329/postgres
MIGRATION_KEY=                 # 自訂長亂數，給 migration-storage-sync 函式當授權用；同一值要設進 Lovable 端 secrets
